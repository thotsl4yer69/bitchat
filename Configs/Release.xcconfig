MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0

// BitNow is its own installable product. Local.xcconfig may override these
// values for a developer's registered identifiers and signing team.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
PRODUCT_BUNDLE_IDENTIFIER = app.bitnow.mesh
APP_GROUP_ID = group.app.bitnow.mesh

// Keep local signing details out of source control while allowing both Debug
// and Release device builds to use the same developer-specific override.
#include? "Local.xcconfig"
